---
import Layout from "../layouts/Layout.astro";
import Wordmark from "../components/Wordmark.astro";
import SignalsGrid from "../components/SignalsGrid.astro";
import Hero from "../components/Hero.astro";
import { ConversationExplainer } from "../components/ConversationExplainer";
import SampleDigest from "../components/SampleDigest.astro";
import CtaSection from "../components/CtaSection.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="CustomerCue">
  <header class="flex items-center px-6 py-5 md:px-10">
    <Wordmark />
  </header>
  <main>
    <Hero />
    <ConversationExplainer client:visible />
    <SignalsGrid />
    <SampleDigest />
    <CtaSection />
  </main>
  <Footer />
</Layout>
