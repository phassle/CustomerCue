---
import type { ExampleOutput } from "../data/example-outputs";

interface Props {
  example: ExampleOutput;
}

const { example } = Astro.props;
---

<article class="rounded-lg border border-foreground/10 bg-foreground/[0.03] p-6">
  <div class="mb-3 flex items-center justify-between gap-4">
    <h4 class="font-display text-lg font-bold text-foreground">{example.accountName}</h4>
    <span class="shrink-0 rounded-sm bg-accent/15 px-2 py-0.5 text-xs font-medium tracking-wide text-accent">
      EXAMPLE — fictional
    </span>
  </div>

  <p class="mb-4 text-sm leading-relaxed text-muted">{example.narrative}</p>

  <div class="mb-4 flex flex-wrap gap-4">
    {example.metrics.map((m) => (
      <div>
        <span class="block text-xs uppercase tracking-wider text-muted">{m.label}</span>
        <span class="font-mono text-sm font-medium text-foreground">{m.value}</span>
      </div>
    ))}
  </div>

  <div class="flex flex-wrap gap-2">
    {example.signalType.map((st) => (
      <span class="rounded-sm bg-foreground/10 px-2 py-0.5 text-xs text-foreground">{st}</span>
    ))}
  </div>
</article>
