---
import { digestFixture } from "../data/digest-fixture";

const { from, to, subject, weekLabel, fictionalBadge, entries } = digestFixture;
---

<section id="sample-digest" class="px-6 py-20 md:px-10">
  <h2 class="font-display text-2xl font-bold tracking-tight md:text-3xl mb-4">
    What arrives on Monday morning
  </h2>
  <p class="text-muted mb-10 max-w-2xl">
    Each Monday, a digest of revenue signals from your support inbox. This is fictional, but it's the shape of the thing.
  </p>

  <div class="mx-auto max-w-3xl rounded-lg border border-foreground/10 bg-foreground/[0.03]">
    <div class="border-b border-foreground/10 px-5 py-4 font-mono text-sm leading-relaxed">
      <div class="flex items-center gap-2 mb-1">
        <span class="text-foreground/60">From:</span>
        <span>{from}</span>
        <span class="ml-auto rounded border border-accent/40 px-2 py-0.5 text-xs font-semibold text-accent">
          {fictionalBadge}
        </span>
      </div>
      <div class="mb-1"><span class="text-foreground/60">To:</span> {to}</div>
      <div class="mb-1"><span class="text-foreground/60">Subject:</span> {subject}</div>
      <div><span class="text-foreground/60">Week:</span> {weekLabel}</div>
    </div>

    <div class="divide-y divide-foreground/10">
      {entries.map((entry) => (
        <div class="px-5 py-5">
          <div class="flex items-start gap-3 mb-2">
            <span role="img" aria-label={entry.glyphLabel} class="text-xl leading-none mt-0.5">
              {entry.glyph}
            </span>
            <div class="min-w-0">
              <span class="font-mono text-xs font-semibold tracking-wider text-accent uppercase">
                {entry.signalType}
              </span>
              <h3 class="font-display text-base font-semibold mt-1">
                {entry.account}
              </h3>
              <p class="text-sm text-foreground/60 mt-0.5">{entry.headline}</p>
            </div>
          </div>

          <div class="ml-8 space-y-1 mb-3">
            {entry.supportingLines.map((line) => (
              <p class="text-sm text-foreground/80">{line}</p>
            ))}
          </div>

          <details class="ml-8">
            <summary class="cursor-pointer text-sm text-accent hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-accent">
              View {entry.sourceConversationCount} source conversation{entry.sourceConversationCount === 1 ? "" : "s"}
            </summary>
            <div class="mt-3 space-y-3">
              {entry.sourceExcerpts.map((excerpt) => (
                <blockquote class="border-l-2 border-foreground/10 pl-4 text-sm">
                  <p class="text-foreground/80 italic">"{excerpt.snippet}"</p>
                  <cite class="mt-1 block text-xs text-foreground/60 not-italic">— {excerpt.from}</cite>
                </blockquote>
              ))}
            </div>
          </details>
        </div>
      ))}
    </div>
  </div>

  <p class="mt-6 text-center text-xs text-muted max-w-2xl mx-auto">
    Fictional data — Acme Corp, NordicPay, and the step-3 cluster are illustrations from our positioning brief.
  </p>
</section>
