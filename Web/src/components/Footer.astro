---
import Wordmark from "./Wordmark.astro";

const year = new Date().getFullYear();
const LINK_CLASS = "text-sm text-muted hover:text-foreground transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-background rounded-sm";
const PLACEHOLDER_CLASS = "text-sm text-muted";
---

<footer class="border-t border-muted/20 px-6 py-12 md:px-10 mt-20">
  <div class="mx-auto max-w-6xl">
    <div class="grid grid-cols-2 gap-8 md:grid-cols-4">
      <div>
        <h3 class="text-sm font-display font-semibold text-foreground mb-3">Product</h3>
        <ul class="space-y-2">
          <li><a href="#signals" class={LINK_CLASS}>Signals</a></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-display font-semibold text-foreground mb-3">Company</h3>
        <ul class="space-y-2">
          <li><span class={PLACEHOLDER_CLASS}>About (coming soon)</span></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-display font-semibold text-foreground mb-3">Legal</h3>
        <ul class="space-y-2">
          <li><span class={PLACEHOLDER_CLASS}>Privacy (coming soon)</span></li>
          <li><span class={PLACEHOLDER_CLASS}>Terms (coming soon)</span></li>
        </ul>
      </div>
      <div>
        <h3 class="text-sm font-display font-semibold text-foreground mb-3">Contact</h3>
        <ul class="space-y-2">
          <li><a href="mailto:hello@customercue.com" class={LINK_CLASS}>hello@customercue.com</a></li>
        </ul>
      </div>
    </div>
    <div class="mt-12 flex flex-col items-center gap-4 md:flex-row md:justify-between">
      <div class="opacity-80">
        <Wordmark />
      </div>
      <p class="text-sm text-muted">&copy; {year} CustomerCue</p>
    </div>
  </div>
</footer>
