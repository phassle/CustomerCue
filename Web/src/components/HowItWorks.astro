---
import ExampleCard from "./ExampleCard.astro";
import { exampleOutputs } from "../data/example-outputs";

const steps = [
  { number: "1", title: "Connect your support inbox", description: "Link Intercom or Zendesk in one click. CustomerCue reads conversations — never replies." },
  { number: "2", title: "AI reads every conversation", description: "Each ticket is classified against your customer and revenue data to surface what matters." },
  { number: "3", title: "Signals are prioritized", description: "Churn risk, expansion intent, product friction — ranked by revenue impact, not ticket volume." },
  { number: "4", title: "Weekly revenue signals delivered", description: "A prioritized report lands in Slack or email so CS, Product, and Sales act on what matters." },
];
---

<section id="how-it-works" class="mx-auto max-w-5xl px-6 py-24 md:px-10">
  <h2 class="mb-4 font-display text-2xl font-bold md:text-3xl">How it works</h2>
  <p class="mb-12 max-w-2xl text-muted">
    From inbox to insight in four steps. No bot replies, no workflow changes — just signals your team can act on.
  </p>

  <ol class="mb-16 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
    {steps.map((step) => (
      <li class="relative pl-10">
        <span class="absolute left-0 top-0 font-mono text-2xl font-bold text-accent">{step.number}</span>
        <h3 class="mb-1 font-display text-base font-bold">{step.title}</h3>
        <p class="text-sm text-muted">{step.description}</p>
      </li>
    ))}
  </ol>

  <h3 class="mb-6 font-display text-xl font-bold">Example signals</h3>
  <div class="grid gap-6 md:grid-cols-3">
    {exampleOutputs.map((ex) => (
      <ExampleCard example={ex} />
    ))}
  </div>
</section>
